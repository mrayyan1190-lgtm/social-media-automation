# Environment template. Copy to `.env` (gitignored) and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Local infrastructure (read by docker-compose.yml)
# ---------------------------------------------------------------------------
# Must meet SQL Server complexity rules (8+ chars, upper, lower, digit, symbol).
MSSQL_SA_PASSWORD=

# ---------------------------------------------------------------------------
# Backend settings (Api + Worker)
# Locally: `dotnet user-secrets set "<Section:Key>" "<value>" --project backend/src/SocialMediaAutomation.Api`
#          (one shared store for Api and Worker; see README.md).
# Deployed: environment variables; a double underscore separates nested sections.
# Non-secret keys and defaults live in each project's appsettings.json.
# ---------------------------------------------------------------------------
# ConnectionStrings__Core=Server=localhost,1433;Database=SocialMediaAutomation;User Id=sa;Password=<MSSQL_SA_PASSWORD>;TrustServerCertificate=True
# ASPNETCORE_ENVIRONMENT=Development              # Api
# DOTNET_ENVIRONMENT=Development                  # Worker
# Workers__Publishing__PollIntervalSeconds=5       # Worker: publishing poll interval
# Workers__Mode=Combined                          # Ai | Publishing | Combined (required outside Development)
# Seed__DemoData=true                             # Api: seed demo workspaces/users at startup (Development default)
# Security__RequireHttps=true                    # Api: HSTS + HTTPS redirect (default on in Production)
# Security__TrustForwardedHeaders=false           # Api: true only behind a TLS-terminating reverse proxy
# RateLimiting__LoginPerMinute=10                 # Api: also AiPerMinute=20, OAuthPerMinute=10, UploadPerMinute=30
# Seed__DemoPassword=                             # SECRET: shared password for seeded demo users
#
# LLM provider, model and API key are configured per workspace in the app (Settings > AI settings), not here.
# DataProtection__KeysPath=../../.local-storage/data-protection-keys   # key ring that encrypts stored LLM keys; must be shared by Api and Worker and persisted
#
# Storage__Provider=Local                         # Local (development); Azure Blob for staging is not implemented yet
# Storage__LocalRoot=../../.local-storage/media   # relative to each project folder
# Storage__ConnectionString=                      # SECRET (future blob provider)
#
# App__WebBaseUrl=http://localhost:4200          # Api: where the OAuth callback returns the browser
# SocialProviders__LinkedIn__RedirectUri=http://localhost:4200/api/v1/oauth/linkedin/callback   # same pattern for Facebook/Instagram
# SocialProviders__LinkedIn__ApiVersion=202509        # LinkedIn-Version header for publishing (yyyyMM)
# Authentication__Google__ClientId=                   # optional "Continue with Google"; redirect URI: <web>/api/v1/auth/google/callback
# Authentication__Google__ClientSecret=
# SocialProviders__LinkedIn__ClientId=
# SocialProviders__LinkedIn__ClientSecret=        # SECRET
# SocialProviders__Facebook__AppId=
# SocialProviders__Facebook__AppSecret=           # SECRET
# SocialProviders__Instagram__AppId=
# SocialProviders__Instagram__AppSecret=          # SECRET
