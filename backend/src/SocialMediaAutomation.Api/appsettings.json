{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "IncludeScopes": true, "UseUtcTimestamp": true, "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ " }
    }
  },
  "AllowedHosts": "*",
  "App": {
    "WebBaseUrl": ""
  },
  "ConnectionStrings": {
    "Core": ""
  },
  "DataProtection": {
    "KeysPath": "../../.local-storage/data-protection-keys"
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "../../.local-storage/media"
  },
  "SocialProviders": {
    "LinkedIn": { "ClientId": "", "RedirectUri": "", "ApiVersion": "" },
    "Facebook": { "AppId": "", "RedirectUri": "", "GraphApiVersion": "" },
    "Instagram": { "AppId": "", "RedirectUri": "", "GraphApiVersion": "" }
  },
  "Ai": {
    "Provider": "OpenAI",
    "BaseUrl": "",
    "Model": "",
    "ApiKey": ""
  },
  "Authentication": {}
}
