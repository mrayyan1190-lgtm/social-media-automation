# Template for /etc/sma.env on the EC2 server (chmod 600). Never commit real values.
# Read by both systemd units (sma-api, sma-worker).

# Company VPS SQL Server. Its firewall must allow port 1433 from the EC2 Elastic IP only.
ConnectionStrings__Core=Server=<vps-host>,1433;Database=SocialMediaAutomation;User Id=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=True

ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000
Workers__Mode=Combined
Security__TrustForwardedHeaders=true

DataProtection__KeysPath=/var/lib/sma/keys
Storage__Provider=Local
Storage__LocalRoot=/var/lib/sma/media

App__WebBaseUrl=https://<your-domain>

# Optional, only for the providers you use (redirect URIs must also be registered with the provider):
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=
# SocialProviders__LinkedIn__ClientId=
# SocialProviders__LinkedIn__ClientSecret=
# SocialProviders__LinkedIn__RedirectUri=https://<your-domain>/api/v1/oauth/linkedin/callback
# SocialProviders__Facebook__AppId=
# SocialProviders__Facebook__AppSecret=
# SocialProviders__Facebook__RedirectUri=https://<your-domain>/api/v1/oauth/facebook/callback
# SocialProviders__Instagram__AppId=
# SocialProviders__Instagram__AppSecret=
# SocialProviders__Instagram__RedirectUri=https://<your-domain>/api/v1/oauth/instagram/callback
